---
import Icon from './Icon.astro';
import {
  type Conference,
  TOPIC_LABELS,
  FORMAT_LABELS,
  formatDate,
  formatRangeShort,
  iso,
  location,
  yearLabel,
  areasOf,
} from '../lib/conferences';
import { issueUrl } from '../site.config';
import { calendarDay, DEADLINE_LABELS, deadlineSummary, deadlineCountdown, deadlineState, openDeadlines, reviewDue } from '../lib/calendar';

interface Props {
  conference: Conference;
  today?: string;
}

const { conference: c, today = calendarDay() } = Astro.props;
const deadlines = c.deadlines.map(d => ({ ...d, date: iso(d.date) }));
const next = openDeadlines(deadlines, today)[0];
const needsReview = reviewDue(c.checked && iso(c.checked), deadlines, today);
const hasCoords = c.lat != null && c.lon != null;
const search = [c.name, c.acronym, c.city, c.country, c.region, ...c.topics]
  .filter(Boolean)
  .join(' ')
  .toLowerCase();
const title = c.acronym ?? c.name;
const detailsId = `details-${c.id}`;
const correctionUrl = issueUrl('correction.yml', { title: `Correction: ${title}`, conference: `${title} (${c.id})` });
---

<li
  class="row"
  id={`conf-${c.id}`}
  data-id={c.id}
  data-start={iso(c.start)}
  data-end={iso(c.end)}
  data-areas={areasOf(c).join(' ')}
  data-region={c.region}
  data-format={c.format}
  data-country={c.countryCode ?? ''}
  data-search={search}
  data-deadlines={JSON.stringify(deadlines)}
  data-deadline-status={c.deadlineStatus}
>
  <div class="r-date">
    <span class="r-range">{formatRangeShort(c.start, c.end)}</span>
    <span class="r-year">{yearLabel(c.start, c.end)}</span>
    <span class="when" data-when></span>
    {c.tentative && <span class="badge badge-tbc" title="The organisers haven't confirmed these dates yet">Dates TBC</span>}
  </div>

  <div class="r-main">
    <h3 class="r-title">
      <a href={c.url} target="_blank" rel="noopener">{title}</a>
    </h3>
    {c.acronym && <p class="r-name">{c.name}</p>}
    {
      c.topics.length > 0 && (
        <ul class="r-topics" aria-label="Topics">
          {c.topics.map((t) => (
            <li class="tag">{TOPIC_LABELS[t]}</li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="r-place">
    <span class="r-city">
      {
        c.countryCode && (
          <img class="flag" src={`/flags/${c.countryCode.toLowerCase()}.svg`} alt="" width="20" height="15" loading="lazy" decoding="async" />
        )
      }
      <span>{location(c)}</span>
    </span>
    <span class="r-sub">{FORMAT_LABELS[c.format]}</span>
  </div>

  <div class="r-deadline" data-next-deadline>
    {next ? <>
      <span class="nd-label">{next.label}</span>
      <span class="nd-meta" data-state={deadlineState(next.date, today)}>{formatDate(new Date(next.date))} · {deadlineCountdown(next.date, today)}{next.tentative ? ' · TBC' : ''}</span>
    </> : <span class="r-sub">{deadlineSummary(deadlines, c.deadlineStatus, today)}</span>}
  </div>

  <div class="r-actions">
    <a class="icon-btn" href={c.url} target="_blank" rel="noopener" title="Conference website" aria-label={`${title} website`}>
      <Icon name="external" size={16} />
    </a>
    {
      hasCoords && (
        <button class="icon-btn" type="button" data-locate data-enhanced hidden title="Show on map" aria-label={`Show ${title} on the map`}>
          <Icon name="pin" size={16} />
        </button>
      )
    }
  </div>

  <details class="r-details" id={detailsId}>
    <summary aria-label={`Details for ${title}`}>Details <Icon name="chevron" size={14} /></summary>
    <div class="r-details-body">
    {c.description && <p class="r-desc">{c.description}</p>}
    {
      c.note && (
        <p class="r-note">
          <Icon name="info" size={15} /> <span>{c.note}</span>
        </p>
      )
    }
    {
      c.deadlines.length > 0 && (
        <ul class="r-deadlines" aria-label="Deadlines">
          {c.deadlines.map((d) => (
            <li data-date={iso(d.date)} data-state={deadlineState(iso(d.date), today)} data-tentative={d.tentative ? '' : undefined}>
              <span class="dl-date">{formatDate(d.date)}</span>
              <span class="dl-label">
                {d.label}
                <small class="dl-types">{d.types.map(t => DEADLINE_LABELS[t]).join(' · ')}</small>
                {d.tentative && <span class="badge badge-tbc" title="Inferred date: the official page doesn't give the full date">TBC</span>}
              </span>
              <span class="dl-status" data-status>{deadlineCountdown(iso(d.date), today)}</span>
            </li>
          ))}
        </ul>
      )
    }
    {c.deadlines.length === 0 && <p class="r-sub">{deadlineSummary(deadlines, c.deadlineStatus, today)}. Check the official website for updates.</p>}
    <div class="r-foot">
      {
        c.source && (
          <p class="r-source">
            Checked at{' '}
            <a href={c.source} target="_blank" rel="noopener">
              {new URL(c.source).hostname.replace(/^www\./, '')}
            </a>
            {c.checked && (
              <>
                {' · '}
                <time datetime={iso(c.checked)} data-checked class:list={{ 'is-stale': needsReview }}>{formatDate(c.checked)}</time>
                <span data-review-note hidden={!needsReview}> · Review due</span>
              </>
            )}
          </p>
        )
      }
      <div class="r-links">
        <a class="link-btn" href={c.url} target="_blank" rel="noopener"><Icon name="external" size={14} /> Website</a>
        <button class="link-btn" type="button" data-copy-link data-enhanced hidden><Icon name="link" size={14} /> <span>Copy link</span></button>
        {correctionUrl && <a class="link-btn" href={correctionUrl} target="_blank" rel="noopener"><Icon name="github" size={14} /> Suggest a correction</a>}
      </div>
    </div>
    </div>
  </details>
</li>
