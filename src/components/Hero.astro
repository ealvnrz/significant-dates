---
interface Props {
  upcoming: number;
  countries: number;
  openDeadlines: number;
  /** Most recent `checked` date across the list, already formatted. */
  lastChecked: string | null;
}

const { upcoming, countries, openDeadlines, lastChecked } = Astro.props;

// Decorative figure, computed at build time with a fixed seed:
//   1. a simulated Thomas cluster process (Poisson parents, Poisson(μ) offspring ~ N(0, σ²I)),
//   2. its Gaussian kernel density estimate on a grid (bandwidth h),
//   3. contour lines of that estimate, traced with marching squares.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20260930);
const gauss = () => Math.sqrt(-2 * Math.log(1 - rand())) * Math.cos(2 * Math.PI * rand());
const poisson = (lambda: number) => {
  const L = Math.exp(-lambda);
  let k = 0;
  let p = 1;
  do {
    k++;
    p *= rand();
  } while (p > L);
  return k - 1;
};

const W = 560;
const H = 380;
const meanParents = 15;
const mu = 14;
const sigma = 24;
const h = 27; // KDE bandwidth
const pad = 2 * sigma;

// 1. Thomas process
const parents = Array.from({ length: poisson(meanParents) }, () => ({
  x: -pad + rand() * (W + 2 * pad),
  y: -pad + rand() * (H + 2 * pad),
}));
const points: { x: number; y: number }[] = [];
for (const p of parents) {
  const n = poisson(mu);
  for (let i = 0; i < n; i++) {
    const x = p.x + sigma * gauss();
    const y = p.y + sigma * gauss();
    if (x >= 0 && x <= W && y >= 0 && y <= H) points.push({ x, y });
  }
}

// 2. Gaussian KDE on a grid that extends past the frame, so contours run off the edges.
const cell = 5;
const x0 = -20;
const y0 = -20;
const nx = Math.ceil((W + 40) / cell) + 1;
const ny = Math.ceil((H + 40) / cell) + 1;
const grid: number[][] = [];
let max = 0;
for (let j = 0; j < ny; j++) {
  const row: number[] = [];
  for (let i = 0; i < nx; i++) {
    const gx = x0 + i * cell;
    const gy = y0 + j * cell;
    let v = 0;
    for (const p of points) {
      const dx = gx - p.x;
      const dy = gy - p.y;
      const d2 = dx * dx + dy * dy;
      if (d2 < 16 * h * h) v += Math.exp(-d2 / (2 * h * h));
    }
    row.push(v);
    if (v > max) max = v;
  }
  grid.push(row);
}

// 3. Marching squares, with segments joined into polylines.
type Pt = [number, number];
function contour(level: number): string {
  const segs: [Pt, Pt][] = [];
  const lerp = (a: number, b: number) => (level - a) / (b - a);
  for (let j = 0; j < ny - 1; j++) {
    for (let i = 0; i < nx - 1; i++) {
      const tl = grid[j][i];
      const tr = grid[j][i + 1];
      const br = grid[j + 1][i + 1];
      const bl = grid[j + 1][i];
      const idx = (tl > level ? 8 : 0) | (tr > level ? 4 : 0) | (br > level ? 2 : 0) | (bl > level ? 1 : 0);
      if (idx === 0 || idx === 15) continue;
      const X = (u: number) => x0 + u * cell;
      const Y = (v: number) => y0 + v * cell;
      const T: Pt = [X(i + lerp(tl, tr)), Y(j)];
      const R: Pt = [X(i + 1), Y(j + lerp(tr, br))];
      const B: Pt = [X(i + lerp(bl, br)), Y(j + 1)];
      const Lp: Pt = [X(i), Y(j + lerp(tl, bl))];
      const centreHigh = (tl + tr + br + bl) / 4 > level;
      const table: Record<number, [Pt, Pt][]> = {
        1: [[Lp, B]], 2: [[B, R]], 3: [[Lp, R]], 4: [[T, R]],
        5: centreHigh ? [[T, Lp], [B, R]] : [[T, R], [Lp, B]],
        6: [[T, B]], 7: [[T, Lp]], 8: [[T, Lp]], 9: [[T, B]],
        10: centreHigh ? [[T, R], [Lp, B]] : [[T, Lp], [B, R]],
        11: [[T, R]], 12: [[Lp, R]], 13: [[B, R]], 14: [[Lp, B]],
      };
      segs.push(...table[idx]);
    }
  }

  const key = (p: Pt) => `${p[0].toFixed(2)},${p[1].toFixed(2)}`;
  const byEnd = new Map<string, number[]>();
  segs.forEach(([a, b], k) => {
    for (const p of [a, b]) byEnd.set(key(p), [...(byEnd.get(key(p)) ?? []), k]);
  });
  const used = new Set<number>();
  const f = (n: number) => n.toFixed(1);
  let d = '';
  for (let s = 0; s < segs.length; s++) {
    if (used.has(s)) continue;
    used.add(s);
    const line: Pt[] = [segs[s][0], segs[s][1]];
    // Extend forward, then backward.
    for (const forward of [true, false]) {
      for (;;) {
        const end = forward ? line[line.length - 1] : line[0];
        const next = (byEnd.get(key(end)) ?? []).find((k) => !used.has(k));
        if (next === undefined) break;
        used.add(next);
        const [a, b] = segs[next];
        const other = key(a) === key(end) ? b : a;
        if (forward) line.push(other);
        else line.unshift(other);
      }
    }
    d += `M${line.map((p) => `${f(p[0])} ${f(p[1])}`).join('L')}`;
  }
  return d;
}

const levels = [0.1, 0.25, 0.42, 0.6, 0.8].map((q, k, all) => ({
  d: contour(q * max),
  opacity: 0.28 + (0.62 * k) / (all.length - 1),
  delay: k * 0.12,
}));
const f = (n: number) => n.toFixed(1);
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <p class="eyebrow">Statistics &amp; probability · worldwide</p>
      <h1>The statistics conference calendar</h1>
      <p class="hero-lede">
        Upcoming conferences and workshops, from the large international congresses to specialised
        meetings, with their submission deadlines. Every date is checked against the official site.
      </p>
      <dl class="hero-stats">
        <div>
          <dt>Upcoming conferences</dt>
          <dd data-stat="upcoming">{upcoming}</dd>
        </div>
        <div>
          <dt>Countries</dt>
          <dd data-stat="countries">{countries}</dd>
        </div>
        <div>
          <dt>Open deadlines</dt>
          <dd data-stat="open-deadlines">{openDeadlines}</dd>
        </div>
      </dl>
      {lastChecked && <p class="hero-updated">Last checked {lastChecked}</p>}
    </div>

    <figure class="hero-figure" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
        <defs>
          <filter id="kde-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="16" />
          </filter>
        </defs>
        <g class="kde-glow" filter="url(#kde-glow)">
          {points.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="9" />)}
        </g>
        <g class="kde-contours">
          {
            levels.map((l) => (
              <path d={l.d} pathLength="1" style={`--o:${l.opacity.toFixed(2)};--delay:${l.delay}s`} />
            ))
          }
        </g>
        <g class="kde-points">
          {points.map((p) => <circle cx={f(p.x)} cy={f(p.y)} r="1.7" />)}
        </g>
      </svg>
      <figcaption>
        Kernel density contours · simulated Thomas process (μ = {mu}, σ = {sigma})
      </figcaption>
    </figure>
  </div>
</section>
